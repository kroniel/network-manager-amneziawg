[VPN Connection]
name=amneziawg
service=org.freedesktop.NetworkManager.amneziawg
program=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBEXECDIR@/nm-amneziawg-service
supports-multiple-connections=false

[libnm]
plugin=libnm-vpn-plugin-amneziawg.so

[GNOME]
auth-dialog=/usr/libexec/nm-amneziawg-service
properties=libnm-gtk4-vpn-plugin-amneziawg-editor
supports-external-ui-mode=true
